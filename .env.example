# ==========================================
# GEMINI & PLATFORM CONFIGURATION (AI Studio)
# ==========================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==========================================
# FIREBASE CONFIGURATION (Vercel & Firebase)
# ==========================================
# Consigue estos valores en tu consola de Firebase:
# Configuración del Proyecto -> General -> Tus apps -> SDK setup and configuration (Web)
VITE_FIREBASE_API_KEY="AIzaSyTU_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto-firebase.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-firebase"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto-firebase.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456789"
