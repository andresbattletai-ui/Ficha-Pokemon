# ==========================================
# FIREBASE CONFIGURATION (Vercel & fichapokemon-e3cde)
# ==========================================
# Consigue estos valores en tu consola de Firebase (proyecto fichapokemon-e3cde):
# Configuración del Proyecto -> General -> Tus apps -> SDK setup and configuration (Web)
# Luego agrégalas en Vercel -> Settings -> Environment Variables
VITE_FIREBASE_API_KEY="AIzaSyTU_API_KEY_DE_FICHAPOKEMON"
VITE_FIREBASE_AUTH_DOMAIN="fichapokemon-e3cde.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="fichapokemon-e3cde"
VITE_FIREBASE_STORAGE_BUCKET="fichapokemon-e3cde.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="TU_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="1:TU_SENDER_ID:web:TU_APP_ID"
